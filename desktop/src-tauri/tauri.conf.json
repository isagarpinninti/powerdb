{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PowerDB",
  "version": "0.2.0",
  "identifier": "dev.powerdb.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PowerDB Manager",
        "width": 1040,
        "height": 700,
        "minWidth": 860,
        "minHeight": 580,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Run and manage a local PowerDB server",
    "longDescription": "PowerDB Manager installs and runs a PowerDB server on this computer: start and stop it, open the dashboard, see its log, take and restore backups.",
    "copyright": "Copyright (c) 2026 Sagar Pinninti. MIT License.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/powerdb"],
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-" },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
