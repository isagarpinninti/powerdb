[Unit]
Description=PowerDB
After=network-online.target
Wants=network-online.target

[Service]
User=powerdb
Group=powerdb
StateDirectory=powerdb
Environment=POWERDB_DATA=/var/lib/powerdb POWERDB_ADDR=127.0.0.1:8090
ExecStart=/usr/local/bin/powerdb serve
Restart=on-failure
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/powerdb

[Install]
WantedBy=multi-user.target
